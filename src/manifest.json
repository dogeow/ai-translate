{
  "manifest_version": 3,
  "name": "Ollama 翻译",
  "version": "0.0.2",
  "description": "Ollama 翻译扩展",
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Ollama 翻译快捷面板",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "contextMenus",
    "tabs",
    "scripting",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*",
    "https://github.com/*",
    "https://models.github.ai/*",
    "https://raw.githubusercontent.com/dogeow/ai-translate/*",
    "https://dict.youdao.com/*"
  ],
  "commands": {
    "translate-selection": {
      "suggested_key": {
        "default": "Alt+T",
        "mac": "Alt+T"
      },
      "description": "翻译选中文本"
    },
    "toggle-page-translate": {
      "suggested_key": {
        "default": "Alt+P",
        "mac": "Alt+P"
      },
      "description": "开始/停止整页翻译"
    },
    "cycle-display-mode": {
      "suggested_key": {
        "default": "Alt+M",
        "mac": "Alt+M"
      },
      "description": "页面翻译显示模式：译文 → 原文 → 双语"
    },
    "toggle-app": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "mac": "Alt+Shift+T"
      },
      "description": "启用/禁用扩展"
    },
    "open-options": {
      "description": "打开扩展设置"
    },
    "translate-page-bilingual": {
      "description": "整页翻译并切换到双语模式"
    },
    "toggle-translate-site": {
      "description": "始终翻译该网站（加入/移出自动翻译白名单）"
    }
  }
}
