{
  "manifest_version": 3,
  "name": "英语学习和AI翻译",
  "version": "0.0.14",
  "description": "支持英语学习和多种 AI 服务的网页翻译扩展",
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "英语学习和AI翻译快捷面板",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "firefox:sidebar_action": {
    "default_title": "英语学习和AI翻译侧边栏",
    "default_panel": "sidepanel.html",
    "default_icon": "icons/icon-32.png",
    "open_at_install": false
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "contextMenus",
    "tabs",
    "scripting",
    "activeTab",
    "declarativeNetRequestWithHostAccess"
  ],
  "chrome:permissions": [
    "storage",
    "contextMenus",
    "tabs",
    "scripting",
    "activeTab",
    "declarativeNetRequestWithHostAccess",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*",
    "https://github.com/*",
    "https://models.github.ai/*",
    "https://auth.openai.com/*",
    "https://chatgpt.com/*",
    "https://dict.youdao.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "chatgpt_codex_client_headers",
        "enabled": true,
        "path": "rules/chatgpt-codex-client-headers.json"
      },
      {
        "id": "youdao_request_headers",
        "enabled": true,
        "path": "rules/youdao-request-headers.json"
      }
    ]
  },
  "commands": {
    "translate-selection": {
      "suggested_key": {
        "default": "Alt+T",
        "mac": "Alt+T"
      },
      "description": "翻译选中文本"
    },
    "toggle-page-translate": {
      "suggested_key": {
        "default": "Alt+P",
        "mac": "Alt+P"
      },
      "description": "开始/停止整页翻译"
    },
    "cycle-display-mode": {
      "suggested_key": {
        "default": "Alt+M",
        "mac": "Alt+M"
      },
      "description": "页面翻译显示模式：译文 → 原文 → 双语"
    },
    "toggle-app": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "mac": "Alt+Shift+T"
      },
      "description": "启用/禁用扩展"
    },
    "open-options": {
      "description": "打开扩展设置"
    },
    "translate-page-bilingual": {
      "description": "整页翻译并切换到双语模式"
    },
    "toggle-translate-site": {
      "description": "始终翻译该网站（加入/移出自动翻译白名单）"
    },
    "cycle-auto-translate-mode": {
      "description": "切换取词模式：热键 → 双击/三击 → 悬停"
    },
    "toggle-hover-translate-scope": {
      "description": "切换悬停翻译范围：单词/整段"
    },
    "toggle-learning-mode": {
      "description": "开启/关闭句型学习模式"
    },
    "toggle-word-marking": {
      "description": "开启/关闭生词标记"
    },
    "toggle-word-recognition-mode": {
      "description": "开启/关闭认词模式"
    }
  }
}
